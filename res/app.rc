#include <windows.h>
#include <commctrl.h>

1 RT_MANIFEST "app.manifest"

100 DIALOGEX 0, 0, 378, 249
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "postinstall"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Windows Package Manager", -1, 10, 10, 225, 11
    LTEXT "Checking WinGet...", 101, 10, 27, 228, 26
    PUSHBUTTON "Install or &update WinGet", 102, 248, 21, 110, 19
    LTEXT "&Recommended settings", 107, 10, 70, 140, 10
    LISTBOX 103, 10, 84, 143, 153, WS_TABSTOP | WS_VSCROLL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT
    LTEXT "Recommendation", 104, 163, 84, 205, 13
    EDITTEXT 105, 163, 100, 205, 107, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Open settings", 106, 163, 215, 98, 20
    CONTROL "&Apply", 108, "Button", WS_TABSTOP | BS_PUSHBUTTON | NOT WS_VISIBLE, 270, 215, 98, 20
END

200 DIALOGEX 0, 0, 315, 151
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "postinstall - WinGet installation"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Preparing WinGet installation...", 201, 10, 11, 295, 13
    CONTROL "", 202, "msctls_progress32", WS_CHILD | WS_VISIBLE | PBS_MARQUEE, 10, 30, 295, 10
    EDITTEXT 203, 10, 49, 295, 67, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Close", 204, 247, 123, 58, 18
END
